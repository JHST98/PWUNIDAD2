<div class="chat-container">
  <h1>💬 Chat Comunitario</h1>
  <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Conversa con otros usuarios en tiempo real.</p>

  <div id="chat-mensajes" class="chat-box">
    <!-- Los mensajes se cargarán aquí -->
  </div>

  <div class="chat-input-area" style="display:flex; gap:0.5rem;">
    <input type="text" id="mensajeInput" placeholder="Escribe un mensaje..." style="margin-bottom:0;">
    <button id="enviarBtn" style="width:auto; padding: 0 1.5rem;">Enviar</button>
  </div>
</div>